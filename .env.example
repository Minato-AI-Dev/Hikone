# Server-side only. Never expose this as VITE_OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Required server-side origin, without /Hikone/. Verify your actual Pages domain.
HIKONE_ALLOWED_ORIGIN=https://minato-ai-dev.github.io

# Frontend override. Example: https://your-api.example.com/api/hikone-ai
VITE_HIKONE_AI_ENDPOINT=

# Vercel/server only: enable Google Routes API, WALK mode.
# Restrict this key to Routes API on the server; do not prefix it with VITE_.
GOOGLE_MAPS_API_KEY=
# Required public HTTPS URL for a production Pages build.
VITE_WALKING_ROUTE_ENDPOINT=

# Server only. Shared Redis protection is mandatory; missing configuration disables paid APIs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
HIKONE_RATE_LIMIT_SALT=

# Local demos only. Production Pages publishing rejects true.
VITE_ROUTING_DEMO=false
